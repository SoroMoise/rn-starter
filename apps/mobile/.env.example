# Mobile app environment variables
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.

# ─────────────────────────────────────────────────────────────────────────────
# AdMob is not configured here: app ids live in app.config.js, unit ids and
# kill switches in constants/admob.ts. They are public identifiers — the app id
# ships in the manifest, every unit id in the bundle — and an incomplete .env
# shipped a release with empty ids: no ad, no error, no revenue.
# ─────────────────────────────────────────────────────────────────────────────

# RTL restart banner (show a banner prompting restart when RTL language is selected)
RTL_RESTART_BANNER_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# RevenueCat — In-App Purchases / Subscriptions
# Get your API keys from https://app.revenuecat.com/
# ─────────────────────────────────────────────────────────────────────────────
REVENUECAT_IOS_API_KEY=appl_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
REVENUECAT_ANDROID_API_KEY=goog_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Days of premium access granted after local expiry before hard cut-off
SUBSCRIPTION_GRACE_PERIOD_DAYS=7

# Development overrides of the subscription tier. They replace the store's answer
# and are never written to the offline cache, so removing one brings the real tier
# back with nothing to undo; FORCE_FREE wins when both are true. FORCE_PRO opens
# every Pro path before the store has a single product. Never in a release: a release
# build refuses to start with either one true, on this machine as in CI.
FORCE_FREE=false
FORCE_PRO=false

# ─────────────────────────────────────────────────────────────────────────────
# Consent form test aid (Google's UMP) — development builds only
# UMP_DEBUG_GEOGRAPHY=EEA simulates a phone in the EEA, so the GDPR form shows from
# anywhere; leave it empty for the real geography. UMP_TEST_DEVICE_IDS is the phone's
# hashed id, comma-separated for several: UMP logs it in `adb logcat` the first time it
# is asked ("Use new ConsentDebugSettings.Builder().addTestDeviceHashedId(...)"), and
# the debug geography only applies to a registered device. Read under __DEV__ only, and
# a release build refuses to start with either one set, on this machine as in CI: empty
# them before build:aab or build:install. The form is shown once: clear the app's data
# to see it again (ADS.md §10).
# ─────────────────────────────────────────────────────────────────────────────
UMP_DEBUG_GEOGRAPHY=
UMP_TEST_DEVICE_IDS=

# ─────────────────────────────────────────────────────────────────────────────
# Backend API (apps/api — Cloudflare Workers)
# ─────────────────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8787
BACKEND_API_KEY=your-backend-api-key
