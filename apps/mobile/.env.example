# Mobile app environment variables
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.

# ─────────────────────────────────────────────────────────────────────────────
# AdMob is not configured here: app ids live in app.config.js, unit ids and
# kill switches in constants/admob.ts. They are public identifiers — the app id
# ships in the manifest, every unit id in the bundle — and an incomplete .env
# shipped a release with empty ids: no ad, no error, no revenue.
# ─────────────────────────────────────────────────────────────────────────────

# RTL restart banner (show a banner prompting restart when RTL language is selected)
RTL_RESTART_BANNER_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# RevenueCat — In-App Purchases / Subscriptions
# Get your API keys from https://app.revenuecat.com/
# ─────────────────────────────────────────────────────────────────────────────
REVENUECAT_IOS_API_KEY=appl_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
REVENUECAT_ANDROID_API_KEY=goog_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Days of premium access granted after local expiry before hard cut-off
SUBSCRIPTION_GRACE_PERIOD_DAYS=7

# ─────────────────────────────────────────────────────────────────────────────
# Backend API (apps/api — Cloudflare Workers)
# ─────────────────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8787
BACKEND_API_KEY=your-backend-api-key

# ─────────────────────────────────────────────────────────────────────────────
# Legal & App Store links
# ─────────────────────────────────────────────────────────────────────────────
APP_WEBSITE_URL=https://yourapp.example.com
LEGAL_PRIVACY_POLICY_URL=https://yourapp.example.com/privacy
LEGAL_TERMS_OF_SERVICE_URL=https://yourapp.example.com/terms
LEGAL_LICENSES_URL=https://yourapp.example.com/licenses
LEGAL_SUPPORT_EMAIL=mailto:support@example.com

