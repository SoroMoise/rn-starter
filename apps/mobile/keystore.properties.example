# Release signing for the Android build.
#
# Copy this file to `keystore.properties` (gitignored) and fill it in. Gradle reads it at
# build time, so it survives `expo prebuild` regenerating android/.
#
# Generate a keystore once, and keep it somewhere it cannot be lost — Play ties the app
# listing to this key forever, and an app signed with a different one cannot be updated:
#
#   keytool -genkeypair -v -keystore release.keystore -alias upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# `STORE_FILE` is resolved relative to this file unless it is an absolute path.

STORE_FILE=release.keystore
STORE_PASSWORD=
KEY_ALIAS=upload
KEY_PASSWORD=
