{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier -c \"**/*.{ts,tsx,css,json}\"",
    "format": "prettier \"**/*.{ts,tsx,css,json}\" --write"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "eslint": "^9.25.1",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.2.5",
    "typescript": "~5.9.2"
  }
}
